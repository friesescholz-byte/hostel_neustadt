{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hostel-neustadt",
  "main": "_worker.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "HOSTEL_KV",
      "id": "ab1ad5e69a564fa5a609b8d5eb224b0c"
    }
  ]
}
